+        NumiMatter
+        VERSION 0.1.0
+        DESCRIPTION "Compiled heterogeneous matter runtime for Numi Lab"
+        LANGUAGES CXX
+    )
+endif()
+
+set(CMAKE_CXX_STANDARD 23)
