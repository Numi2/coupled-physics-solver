+kernel void nm_mpm_classify_particles(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    constant NMMicrostepGPU& microstep [[buffer(1)]],
+    device const NMContinuumObjectGPU* objects [[buffer(2)]],
+    device const NMMPMGridGPU* grids [[buffer(3)]],
+    device const uint* blockLookup [[buffer(4)]],
+    device const NMParticleStateGPU* particles [[buffer(5)]],
+    device const NMSchedulerStateGPU* schedulers [[buffer(6)]],
+    device const NMAdaptiveStateGPU* adaptive [[buffer(7)]],
+    device NMMatterStatusGPU* statuses [[buffer(8)]],
+    device NMMPMParticleKeyGPU* keys [[buffer(9)]],
+    device atomic_uint* blockCounts [[buffer(10)]],
+    device atomic_uint* activeFlags [[buffer(11)]],
+    uint global [[thread_position_in_grid]]
+) {
+    const uint total = dispatch.environmentCount * dispatch.particleCount;
+    if (global >= total || dispatch.particleCount == 0u) {
+        return;
+    }
+    const uint environment = global / dispatch.particleCount;
+    const uint particleIndex = global - environment * dispatch.particleCount;
+    NMMPMParticleKeyGPU key{};
+    key.identity.x = NM_INVALID_INDEX;
+    keys[global] = key;
+    if (!environmentHealthy(statuses, environment)) {
+        return;
+    }
+    const NMParticleStateGPU particle = particles[global];
+    const uint objectIndex = particle.identity.x;
+    if (objectIndex >= dispatch.objectCount) {
+        recordFailure(
+            statuses[environment],
+            NM_STATUS_INVALID_DISPATCH,
+            objectIndex,
+            particleIndex,
+            float4(0.0f)
+        );
+        return;
+    }
+    const NMContinuumObjectGPU object = objects[objectIndex];
+    if (object.representation != NM_REPRESENTATION_MPM ||
+        object.elementCount != 1u ||
+        object.elementOffset >= dispatch.mpmGridCount) {
+        return;
+    }
+    const NMSchedulerStateGPU scheduler =
+        schedulers[environment * dispatch.objectCount + objectIndex];
+    const NMAdaptiveStateGPU adaptiveState =
+        adaptive[environment * dispatch.objectCount + objectIndex];
+    if (!objectDue(object, scheduler, adaptiveState, microstep) ||
+        (particle.identity.w & NM_OBJECT_ACTIVE) == 0u) {
+        return;
+    }
+    const NMMPMGridGPU grid = grids[object.elementOffset];
+    if (!particleSupportInsideGrid(particle, grid)) {
+        recordFailure(
+            statuses[environment],
+            NM_STATUS_CAPACITY_OVERFLOW,
+            objectIndex,
+            particleIndex,
+            float4(particle.positionAndMass.xyz, 0.0f)
+        );
+        return;
+    }
+    const int3 ownerCoordinate = particleBlockCoordinate(particle, grid);
+    const uint ownerBlock = gridBlockIndex(
+        grid,
+        ownerCoordinate,
+        blockLookup,
+        dispatch.mpmBlockLookupCount
+    );
+    if (ownerBlock == NM_INVALID_INDEX || ownerBlock >= dispatch.mpmBlockCount) {
+        recordFailure(
+            statuses[environment],
+            NM_STATUS_CAPACITY_OVERFLOW,
+            objectIndex,
+            particleIndex,
+            float4(float3(ownerCoordinate), 0.0f)
+        );
+        return;
+    }
+    const uint blockSlot = environment * dispatch.mpmBlockCount + ownerBlock;
+    const uint previous = atomic_fetch_add_explicit(
+        blockCounts + blockSlot,
+        1u,
+        memory_order_relaxed
+    );
+    if (previous >= dispatch.maximumParticlesPerBlock) {
+        recordFailure(
+            statuses[environment],
+            NM_STATUS_CAPACITY_OVERFLOW,
+            objectIndex,
+            ownerBlock,
+            float4(float(previous + 1u), float(dispatch.maximumParticlesPerBlock), 0.0f, 0.0f)
+        );
+        return;
+    }
+    const ulong cellMorton = particleCellMorton(particle, grid);
+    key.identity = {
+        ownerBlock,
+        uint(cellMorton),
+        uint(cellMorton >> 32u),
+        1u,
+    };
+    keys[global] = key;
+
+    // A quadratic kernel reaches at most one neighboring 8^3 block in each
+    // direction. Mark that complete halo so P2G writes every node G2P may read.
+    for (int z = -1; z <= 1; ++z) {
+        for (int y = -1; y <= 1; ++y) {
+            for (int x = -1; x <= 1; ++x) {
+                const uint block = gridBlockIndex(
+                    grid,
+                    ownerCoordinate + int3(x, y, z),
+                    blockLookup,
+                    dispatch.mpmBlockLookupCount
+                );
+                if (block != NM_INVALID_INDEX && block < dispatch.mpmBlockCount) {
+                    atomic_store_explicit(
+                        activeFlags + environment * dispatch.mpmBlockCount + block,
+                        1u,
+                        memory_order_relaxed
+                    );
+                }
+            }
+        }
+    }
+}
+
+kernel void nm_mpm_scan_environment_blocks(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const atomic_uint* blockCounts [[buffer(1)]],
+    device uint* blockOffsets [[buffer(2)]],
+    device const atomic_uint* activeFlags [[buffer(3)]],
+    device uint* activeLocalOffsets [[buffer(4)]],
+    device uint* environmentActiveCounts [[buffer(5)]],
+    device NMMatterStatusGPU* statuses [[buffer(6)]],
+    uint lane [[thread_index_in_threadgroup]],
+    uint environment [[threadgroup_position_in_grid]]
+) {
+    if (environment >= dispatch.environmentCount || lane != 0u) {
+        return;
+    }
+    uint particleCursor = 0u;
+    uint activeCursor = 0u;
+    const uint base = environment * dispatch.mpmBlockCount;
+    for (uint block = 0u; block < dispatch.mpmBlockCount; ++block) {
+        const uint count = atomic_load_explicit(
+            blockCounts + base + block,
+            memory_order_relaxed
+        );
+        blockOffsets[base + block] = particleCursor;
+        particleCursor += count;
+        const uint active = atomic_load_explicit(
+            activeFlags + base + block,
+            memory_order_relaxed
+        );
+        activeLocalOffsets[base + block] = activeCursor;
+        activeCursor += active != 0u ? 1u : 0u;
+    }
+    environmentActiveCounts[environment] = activeCursor;
+    if (particleCursor > dispatch.particleCount) {
+        recordFailure(
+            statuses[environment],
+            NM_STATUS_CAPACITY_OVERFLOW,
+            NM_INVALID_INDEX,
+            particleCursor,
+            float4(float(particleCursor), float(dispatch.particleCount), 0.0f, 0.0f)
+        );
+    }
+}
+
+kernel void nm_mpm_scan_environment_counts(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const uint* environmentActiveCounts [[buffer(1)]],
+    device uint* environmentActiveOffsets [[buffer(2)]],
+    device NMIndirectDispatchGPU* activeDispatch [[buffer(3)]],
+    uint lane [[thread_index_in_threadgroup]]
+) {
+    if (lane != 0u) {
+        return;
+    }
+    uint cursor = 0u;
+    for (uint environment = 0u;
+         environment < dispatch.environmentCount;
+         ++environment) {
+        environmentActiveOffsets[environment] = cursor;
+        cursor += environmentActiveCounts[environment];
+    }
+    activeDispatch[0] = {cursor, 1u, 1u, 0u};
+}
+
+kernel void nm_mpm_scatter_active_blocks(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const atomic_uint* activeFlags [[buffer(1)]],
+    device const uint* activeLocalOffsets [[buffer(2)]],
+    device const uint* environmentActiveOffsets [[buffer(3)]],
+    device const uint* blockOffsets [[buffer(4)]],
+    device const atomic_uint* blockCounts [[buffer(5)]],
+    device NMActiveMPMBlockGPU* activeBlocks [[buffer(6)]],
+    uint global [[thread_position_in_grid]]
+) {
+    const uint total = dispatch.environmentCount * dispatch.mpmBlockCount;
+    if (global >= total || dispatch.mpmBlockCount == 0u ||
+        atomic_load_explicit(activeFlags + global, memory_order_relaxed) == 0u) {
+        return;
+    }
+    const uint environment = global / dispatch.mpmBlockCount;
+    const uint block = global - environment * dispatch.mpmBlockCount;
+    const uint destination = environmentActiveOffsets[environment] +
+        activeLocalOffsets[global];
+    activeBlocks[destination] = {
+        environment,
+        block,
+        blockOffsets[global],
+        atomic_load_explicit(blockCounts + global, memory_order_relaxed),
+    };
+}
+
+kernel void nm_mpm_scatter_particles(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const NMMPMParticleKeyGPU* keys [[buffer(1)]],
+    device const uint* blockOffsets [[buffer(2)]],
+    device atomic_uint* blockCursors [[buffer(3)]],
+    device uint* sortedParticleIndices [[buffer(4)]],
+    uint global [[thread_position_in_grid]]
+) {
+    const uint total = dispatch.environmentCount * dispatch.particleCount;
+    if (global >= total || dispatch.particleCount == 0u) {
+        return;
+    }
+    const uint environment = global / dispatch.particleCount;
+    const uint particle = global - environment * dispatch.particleCount;
+    const NMMPMParticleKeyGPU key = keys[global];
+    const uint block = key.identity.x;
+    if (key.identity.w == 0u || block >= dispatch.mpmBlockCount) {
+        return;
+    }
+    const uint blockSlot = environment * dispatch.mpmBlockCount + block;
+    const uint local = atomic_fetch_add_explicit(
+        blockCursors + blockSlot,
+        1u,
+        memory_order_relaxed
+    );
+    if (local < dispatch.maximumParticlesPerBlock) {
+        sortedParticleIndices[
+            environment * dispatch.particleCount +
+            blockOffsets[blockSlot] + local
+        ] = particle;
+    }
+}
+
+kernel void nm_mpm_sort_block_particles(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const NMActiveMPMBlockGPU* activeBlocks [[buffer(1)]],
+    device const NMMPMParticleKeyGPU* keys [[buffer(2)]],
+    device uint* sortedParticleIndices [[buffer(3)]],
+    uint lane [[thread_index_in_threadgroup]],
+    uint group [[threadgroup_position_in_grid]]
+) {
+    threadgroup uint particleScratch[NM_MPM_MAX_PARTICLES_PER_BLOCK];
+    threadgroup ulong keyScratch[NM_MPM_MAX_PARTICLES_PER_BLOCK];
+    const NMActiveMPMBlockGPU active = activeBlocks[group];
+    const uint count = min(active.particleCount, dispatch.maximumParticlesPerBlock);
+    uint particle = NM_INVALID_INDEX;
+    ulong key = ulong(-1);
+    if (lane < count) {
+        particle = sortedParticleIndices[
+            active.environment * dispatch.particleCount +
+            active.firstParticle + lane
+        ];
+        if (particle < dispatch.particleCount) {
+            const NMMPMParticleKeyGPU record = keys[
+                active.environment * dispatch.particleCount + particle
+            ];
+            key = (ulong(record.identity.z) << 32u) | record.identity.y;
+        }
+    }
+    particleScratch[lane] = particle;
+    keyScratch[lane] = key;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (uint size = 2u; size <= NM_MPM_MAX_PARTICLES_PER_BLOCK; size <<= 1u) {
+        for (uint stride = size >> 1u; stride > 0u; stride >>= 1u) {
+            const uint partner = lane ^ stride;
+            if (partner > lane) {
+                const bool ascending = (lane & size) == 0u;
+                const ulong leftKey = keyScratch[lane];
+                const ulong rightKey = keyScratch[partner];
+                const uint leftParticle = particleScratch[lane];
+                const uint rightParticle = particleScratch[partner];
+                const bool greater = leftKey > rightKey ||
+                    (leftKey == rightKey && leftParticle > rightParticle);
+                const bool swap = ascending ? greater : !greater;
+                if (swap) {
+                    keyScratch[lane] = rightKey;
+                    keyScratch[partner] = leftKey;
+                    particleScratch[lane] = rightParticle;
+                    particleScratch[partner] = leftParticle;
+                }
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+    }
+    if (lane < count) {
+        sortedParticleIndices[
+            active.environment * dispatch.particleCount +
+            active.firstParticle + lane
+        ] = particleScratch[lane];
+    }
+}
+
+inline void evaluateSparseNode(
+    const NMMatterDispatchGPU dispatch,
+    const NMMicrostepGPU microstep,
+    const uint environment,
+    const uint activeBlockIndex,
+    const uint localNode,
+    device const NMContinuumObjectGPU* objects,
+    device const NMMaterialGPU* materials,
+    device const NMScalarProgramGPU* programs,
+    device const NMExpressionInstructionGPU* instructions,
+    device const float* environmentParameters,
+    device const NMParticleStateGPU* particles,
+    device const float* particleMaterialState,
+    device NMGridNodeStateGPU* nodes,
+    device const NMMPMGridGPU* grids,
+    device const NMMPMBlockGPU* blocks,
+    device const uint* blockLookup,
+    device const atomic_uint* blockCounts,
+    device const uint* blockOffsets,
+    device const uint* sortedParticleIndices,
+    device const NMSchedulerStateGPU* schedulers,
+    device const NMAdaptiveStateGPU* adaptive,
+    device uint* nodeGenerations,
+    device NMMatterStatusGPU* statuses
+) {
+    if (activeBlockIndex >= dispatch.mpmBlockCount ||
+        localNode >= NM_MPM_BLOCK_NODE_COUNT) {
+        return;
+    }
+    const NMMPMBlockGPU block = blocks[activeBlockIndex];
+    if (block.identity.z >= dispatch.mpmGridCount ||
+        block.identity.w >= dispatch.objectCount) {
+        return;
+    }
+    const uint objectIndex = block.identity.w;
+    const NMContinuumObjectGPU object = objects[objectIndex];
+    const NMSchedulerStateGPU scheduler =
+        schedulers[environment * dispatch.objectCount + objectIndex];
+    const NMAdaptiveStateGPU adaptiveState =
+        adaptive[environment * dispatch.objectCount + objectIndex];
+    if (!environmentHealthy(statuses, environment) ||
+        object.representation != NM_REPRESENTATION_MPM ||
+        !objectDue(object, scheduler, adaptiveState, microstep)) {
+        return;
+    }
+    const NMMPMGridGPU grid = grids[block.identity.z];
+    const int3 localCoordinate = int3(
+        int(localNode & 7u),
+        int((localNode >> 3u) & 7u),
+        int((localNode >> 6u) & 7u)
+    );
+    const int3 nodeCoordinate = int3(
+        block.coordinateAndLookup.x,
+        block.coordinateAndLookup.y,
+        block.coordinateAndLookup.z
+    ) * int(NM_MPM_BLOCK_EDGE) + localCoordinate;
+    const uint nodeIndex = gridNodeIndex(grid, nodeCoordinate);
+    if (nodeIndex == NM_INVALID_INDEX || nodeIndex >= dispatch.gridNodeCount) {
+        return;
+    }
+    device NMGridNodeStateGPU& node =
+        nodes[environment * dispatch.gridNodeCount + nodeIndex];
+    const float3 nodePosition = float3(nodeCoordinate) * grid.metrics.x;
+    float mass = 0.0f;
+    float3 momentum = float3(0.0f);
+    float3 internalForce = float3(0.0f);
+    float maximumStress = 0.0f;
+    device const float* parameters =
+        environmentParameters + environment * dispatch.parameterCount;
+
+    const int3 blockCoordinate = int3(
+        block.coordinateAndLookup.x,
+        block.coordinateAndLookup.y,
+        block.coordinateAndLookup.z
+    );
+    const uint particleBase = environment * dispatch.particleCount;
+    const uint blockBase = environment * dispatch.mpmBlockCount;
+    for (int neighborZ = -1; neighborZ <= 1; ++neighborZ) {
+        for (int neighborY = -1; neighborY <= 1; ++neighborY) {
+            for (int neighborX = -1; neighborX <= 1; ++neighborX) {
+                const uint neighborBlock = gridBlockIndex(
+                    grid,
+                    blockCoordinate + int3(neighborX, neighborY, neighborZ),
+                    blockLookup,
+                    dispatch.mpmBlockLookupCount
+                );
+                if (neighborBlock == NM_INVALID_INDEX ||
+                    neighborBlock >= dispatch.mpmBlockCount) {
+                    continue;
+                }
+                const uint blockSlot = blockBase + neighborBlock;
+                const uint count = min(
+                    atomic_load_explicit(
+                        blockCounts + blockSlot,
+                        memory_order_relaxed
+                    ),
+                    dispatch.maximumParticlesPerBlock
+                );
+                const uint first = blockOffsets[blockSlot];
+                for (uint local = 0u; local < count; ++local) {
+                    const uint particleIndex = sortedParticleIndices[
+                        particleBase + first + local
+                    ];
+                    if (particleIndex >= dispatch.particleCount) {
+                        continue;
+                    }
+                    const NMParticleStateGPU particle =
+                        particles[particleBase + particleIndex];
+                    if (particle.identity.x != objectIndex ||
+                        (particle.identity.w & NM_OBJECT_ACTIVE) == 0u) {
+                        continue;
+                    }
+                    float wx;
+                    float wy;
+                    float wz;
+                    float dx;
+                    float dy;
+                    float dz;
+                    const float3 deltaCells =
+                        (nodePosition - particle.positionAndMass.xyz) *
+                        grid.metrics.y;
+                    if (!quadraticKernel(deltaCells.x, grid.metrics.y, wx, dx) ||
+                        !quadraticKernel(deltaCells.y, grid.metrics.y, wy, dy) ||
+                        !quadraticKernel(deltaCells.z, grid.metrics.y, wz, dz)) {
+                        continue;
+                    }
+                    const float weight = wx * wy * wz;
+                    const float3 nodeGradient = float3(
+                        dx * wy * wz,
+                        wx * dy * wz,
+                        wx * wy * dz
+                    );
+                    const float3 particleGradient = -nodeGradient;
+                    const float3 displacement =
+                        nodePosition - particle.positionAndMass.xyz;
+                    const float3x3 affine = matrixFromRows(
+                        particle.affineRow0,
+                        particle.affineRow1,
+                        particle.affineRow2
+                    );
+                    const float particleMass = particle.positionAndMass.w;
+                    const float weightedMass = weight * particleMass;
+                    mass += weightedMass;
+                    momentum += weightedMass *
+                        (particle.velocityAndReferenceVolume.xyz +
+                         affine * displacement);
+
+                    const float3x3 deformation = matrixFromRows(
+                        particle.deformationRow0,
+                        particle.deformationRow1,
+                        particle.deformationRow2
+                    );
+                    // APIC stores the spatial velocity gradient L. Matter
+                    // Language exposes the material deformation rate Fdot,
+                    // so MPM supplies Fdot = L F, matching FEM's rest-gradient
+                    // evaluation and preserving one constitutive meaning across
+                    // both discretizations.
+                    const float3x3 deformationRate = affine * deformation;
+                    bool valid = true;
+                    const NMMaterialGPU material = materials[particle.identity.y];
+                    device const float* internalState =
+                        material.stateCount == 0u
+                        ? nullptr
+                        : particleMaterialState +
+                            (particleBase + particleIndex) *
+                                dispatch.materialStateStride;
+                    const float temperature =
+                        particle.referenceAndTemperature.w;
+                    const float3x3 stress = evaluateStress(
+                        material,
+                        programs,
+                        instructions,
+                        parameters,
+                        internalState,
+                        deformation,
+                        deformationRate,
+                        objectTimestep(dispatch, scheduler),
+                        temperature,
+                        valid
+                    );
+                    if (!valid) {
+                        recordFailure(
+                            statuses[environment],
+                            NM_STATUS_NONFINITE_RESULT,
+                            objectIndex,
+                            particleIndex,
+                            float4(determinant(deformation), 0.0f, 0.0f, 0.0f)
+                        );
+                        continue;
+                    }
+                    maximumStress = max(maximumStress, maximumAbs(stress));
+                    internalForce += particle.velocityAndReferenceVolume.w *
+                        ((stress * transpose(deformation)) * particleGradient);
+                }
+            }
+        }
+    }
+
+    node.positionAndMass = float4(nodePosition, mass);
+    node.forceAndEnergy = float4(internalForce, maximumStress);
+    if (mass > 0.0f) {
+        const float inverseMass = 1.0f / mass;
+        const float3 velocity = momentum * inverseMass;
+        const float dt = objectTimestep(dispatch, scheduler);
+        const float3 acceleration =
+            internalForce * inverseMass + dispatch.gravityAndTimestep.xyz;
+        node.velocityAndInverseMass = float4(velocity, inverseMass);
+        node.candidateVelocity = float4(velocity + dt * acceleration, 0.0f);
+        if (!finite3(node.candidateVelocity.xyz)) {
+            recordFailure(
+                statuses[environment],
+                NM_STATUS_NONFINITE_RESULT,
+                objectIndex,
+                nodeIndex,
+                float4(node.candidateVelocity.xyz, maximumStress)
+            );
+        }
+    } else {
+        node.velocityAndInverseMass = float4(0.0f);
+        node.candidateVelocity = float4(0.0f);
+    }
+    nodeGenerations[environment * dispatch.gridNodeCount + nodeIndex] =
+        microstep.reserved;
+}
+
+kernel void nm_mpm_p2g(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    constant NMMicrostepGPU& microstep [[buffer(1)]],
+    device const NMContinuumObjectGPU* objects [[buffer(2)]],
+    device const NMMaterialGPU* materials [[buffer(3)]],
+    device const NMScalarProgramGPU* programs [[buffer(4)]],
+    device const NMExpressionInstructionGPU* instructions [[buffer(5)]],
+    device const float* environmentParameters [[buffer(6)]],
+    device const NMParticleStateGPU* particles [[buffer(7)]],
+    device const float* particleMaterialState [[buffer(8)]],
+    device NMGridNodeStateGPU* nodes [[buffer(9)]],
+    device const NMMPMGridGPU* grids [[buffer(10)]],
+    device const NMMPMBlockGPU* blocks [[buffer(11)]],
+    device const uint* blockLookup [[buffer(12)]],
+    device const NMActiveMPMBlockGPU* activeBlocks [[buffer(13)]],
+    device const atomic_uint* blockCounts [[buffer(14)]],
+    device const uint* blockOffsets [[buffer(15)]],
+    device const uint* sortedParticleIndices [[buffer(16)]],
+    device const NMSchedulerStateGPU* schedulers [[buffer(17)]],
+    device const NMAdaptiveStateGPU* adaptive [[buffer(18)]],
+    device uint* nodeGenerations [[buffer(19)]],
+    device NMMatterStatusGPU* statuses [[buffer(20)]],
+    uint lane [[thread_index_in_threadgroup]],
+    uint group [[threadgroup_position_in_grid]]
+) {
+    const NMActiveMPMBlockGPU active = activeBlocks[group];
+    if (active.environment >= dispatch.environmentCount ||
+        active.blockIndex >= dispatch.mpmBlockCount) {
+        return;
+    }
+    evaluateSparseNode(
+        dispatch,
+        microstep,
+        active.environment,
+        active.blockIndex,
+        lane,
+        objects,
+        materials,
+        programs,
+        instructions,
+        environmentParameters,
+        particles,
+        particleMaterialState,
+        nodes,
+        grids,
+        blocks,
+        blockLookup,
+        blockCounts,
+        blockOffsets,
+        sortedParticleIndices,
+        schedulers,
+        adaptive,
+        nodeGenerations,
+        statuses
+    );
+    evaluateSparseNode(
+        dispatch,
+        microstep,
+        active.environment,
+        active.blockIndex,
+        lane + 256u,
+        objects,
+        materials,
+        programs,
+        instructions,
+        environmentParameters,
+        particles,
+        particleMaterialState,
+        nodes,
+        grids,
+        blocks,
+        blockLookup,
+        blockCounts,
+        blockOffsets,
+        sortedParticleIndices,
+        schedulers,
+        adaptive,
+        nodeGenerations,
+        statuses
+    );
+}
+
+kernel void nm_mpm_g2p(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    constant NMMicrostepGPU& microstep [[buffer(1)]],
+    device const NMContinuumObjectGPU* objects [[buffer(2)]],
+    device const NMMaterialGPU* materials [[buffer(3)]],
+    device const NMScalarProgramGPU* programs [[buffer(4)]],
+    device const NMExpressionInstructionGPU* instructions [[buffer(5)]],
+    device const float* environmentParameters [[buffer(6)]],
+    device const NMParticleStateGPU* accepted [[buffer(7)]],
+    device NMParticleStateGPU* candidate [[buffer(8)]],
+    device const float* acceptedMaterialState [[buffer(9)]],
+    device float* candidateMaterialState [[buffer(10)]],
+    device const NMGridNodeStateGPU* nodes [[buffer(11)]],
+    device const NMMPMGridGPU* grids [[buffer(12)]],
+    device const uint* nodeGenerations [[buffer(13)]],
+    device const NMSchedulerStateGPU* schedulers [[buffer(14)]],
+    device const NMAdaptiveStateGPU* adaptive [[buffer(15)]],
+    device NMMatterStatusGPU* statuses [[buffer(16)]],
+    uint global [[thread_position_in_grid]]
+) {
+    const uint total = dispatch.environmentCount * dispatch.particleCount;
+    if (global >= total || dispatch.particleCount == 0u) {
+        return;
+    }
+    const uint environment = global / dispatch.particleCount;
+    const uint particleIndex = global - environment * dispatch.particleCount;
+    const NMParticleStateGPU particle = accepted[global];
+    const uint materialStateBase = global * dispatch.materialStateStride;
+    for (uint state = 0u; state < dispatch.materialStateStride; ++state) {
+        candidateMaterialState[materialStateBase + state] =
+            acceptedMaterialState[materialStateBase + state];
+    }
+    const uint objectIndex = particle.identity.x;
+    if (objectIndex >= dispatch.objectCount) {
+        candidate[global] = particle;
+        recordFailure(
+            statuses[environment],
+            NM_STATUS_INVALID_DISPATCH,
+            objectIndex,
+            particleIndex,
+            float4(0.0f)
+        );
+        return;
+    }
+    const NMContinuumObjectGPU object = objects[objectIndex];
+    const NMSchedulerStateGPU scheduler =
+        schedulers[environment * dispatch.objectCount + objectIndex];
+    const NMAdaptiveStateGPU adaptiveState =
+        adaptive[environment * dispatch.objectCount + objectIndex];
+    if (!environmentHealthy(statuses, environment) ||
+        object.representation != NM_REPRESENTATION_MPM ||
+        object.elementCount != 1u ||
+        object.elementOffset >= dispatch.mpmGridCount ||
+        !objectDue(object, scheduler, adaptiveState, microstep)) {
+        candidate[global] = particle;
+        return;
+    }
+    const NMMPMGridGPU grid = grids[object.elementOffset];
+    const float3 cell = particle.positionAndMass.xyz * grid.metrics.y;
+    const int3 base = int3(floor(cell - 0.5f));
+    float3 velocity = float3(0.0f);
+    float3x3 velocityGradient = float3x3(0.0f);
+    float3x3 affineMoment = float3x3(0.0f);
+    float weightSum = 0.0f;
+    for (int z = 0; z < 3; ++z) {
+        for (int y = 0; y < 3; ++y) {
+            for (int x = 0; x < 3; ++x) {
+                const int3 coordinate = base + int3(x, y, z);
+                const uint nodeIndex = gridNodeIndex(grid, coordinate);
+                if (nodeIndex == NM_INVALID_INDEX ||
+                    nodeIndex >= dispatch.gridNodeCount ||
+                    nodeGenerations[
+                        environment * dispatch.gridNodeCount + nodeIndex
+                    ] != microstep.reserved) {
+                    candidate[global] = particle;
+                    recordFailure(
+                        statuses[environment],
+                        NM_STATUS_CAPACITY_OVERFLOW,
+                        objectIndex,
+                        particleIndex,
+                        float4(float3(coordinate), 0.0f)
+                    );
+                    return;
+                }
+                const NMGridNodeStateGPU node = nodes[
+                    environment * dispatch.gridNodeCount + nodeIndex
+                ];
+                float wx;
+                float wy;
+                float wz;
+                float dx;
+                float dy;
+                float dz;
+                const float3 deltaCells =
+                    (node.positionAndMass.xyz - particle.positionAndMass.xyz) *
+                    grid.metrics.y;
+                if (!quadraticKernel(deltaCells.x, grid.metrics.y, wx, dx) ||
+                    !quadraticKernel(deltaCells.y, grid.metrics.y, wy, dy) ||
+                    !quadraticKernel(deltaCells.z, grid.metrics.y, wz, dz)) {
+                    continue;
+                }
+                const float weight = wx * wy * wz;
+                const float3 nodeGradient = float3(
+                    dx * wy * wz,
+                    wx * dy * wz,
+                    wx * wy * dz
+                );
+                const float3 displacement =
+                    node.positionAndMass.xyz - particle.positionAndMass.xyz;
+                const float3 nodeVelocity = node.candidateVelocity.xyz;
+                weightSum += weight;
+                velocity += weight * nodeVelocity;
+                velocityGradient += outerProduct(nodeVelocity, nodeGradient);
+                affineMoment += weight * outerProduct(nodeVelocity, displacement);
+            }
+        }
+    }
+    if (!(weightSum > 0.999f && weightSum < 1.001f)) {
+        candidate[global] = particle;
+        recordFailure(
+            statuses[environment],
+            NM_STATUS_CAPACITY_OVERFLOW,
+            objectIndex,
+            particleIndex,
+            float4(weightSum, particle.positionAndMass.xyz)
+        );
+        return;
+    }
+    const float dt = objectTimestep(dispatch, scheduler);
+    const float3x3 deformation = matrixFromRows(
+        particle.deformationRow0,
+        particle.deformationRow1,
+        particle.deformationRow2
+    );
+    const float3x3 nextDeformation =
+        (float3x3(1.0f) + dt * velocityGradient) * deformation;
+    // G2P reconstructs the spatial velocity gradient L. Constitutive and
+    // evolution programs consume the material rate Fdot = L F at the same
+    // candidate state used for validity and publication.
+    const float3x3 nextDeformationRate =
+        velocityGradient * nextDeformation;
+    const float determinantValue = determinantSafe(nextDeformation);
+    const NMMaterialGPU material = materials[particle.identity.y];
+    bool valid = isfinite(determinantValue) &&
+        determinantValue >= material.validity.x &&
+        determinantValue <= material.validity.y;
+    device const float* internalState = material.stateCount == 0u
+        ? nullptr
+        : acceptedMaterialState + materialStateBase;
+    float validityMargin = 1.0f;
+    if (valid) {
+        valid = evaluateMaterialValidity(
+            material,
+            programs,
+            instructions,
+            environmentParameters +
+                environment * dispatch.parameterCount,
+            internalState,
+            nextDeformation,
+            nextDeformationRate,
+            dt,
+            particle.referenceAndTemperature.w,
+            validityMargin
+        ) && validityMargin > 0.0f;
+    }
+    if (!valid || !finite3(velocity)) {
+        candidate[global] = particle;
+        recordFailure(
+            statuses[environment],
+            NM_STATUS_INVALID_DEFORMATION,
+            objectIndex,
+            particleIndex,
+            float4(
+                determinantValue,
+                length(velocity),
+                maximumAbs(velocityGradient),
+                weightSum
+            )
+        );
+        return;
+    }
+
+    NMParticleStateGPU next = particle;
+    next.positionAndMass.xyz += dt * velocity;
+    next.velocityAndReferenceVolume.xyz = velocity;
+    matrixToRows(
+        nextDeformation,
+        next.deformationRow0,
+        next.deformationRow1,
+        next.deformationRow2
+    );
+    // Quadratic B-spline APIC has a constant inverse second moment of 4/h^2.
+    const float3x3 affine = 4.0f * grid.metrics.y * grid.metrics.y *
+        affineMoment;
+    matrixToRows(
+        affine,
+        next.affineRow0,
+        next.affineRow1,
+        next.affineRow2
+    );
+    if (!particleSupportInsideGrid(next, grid)) {
+        candidate[global] = particle;
+        recordFailure(
+            statuses[environment],
+            NM_STATUS_CAPACITY_OVERFLOW,
+            objectIndex,
+            particleIndex,
+            float4(next.positionAndMass.xyz, 0.0f)
+        );
+        return;
+    }
+    for (uint state = 0u; state < material.stateCount; ++state) {
+        float nextState = 0.0f;
+        if (!evaluateStateUpdate(
+                material,
+                state,
+                programs,
+                instructions,
+                environmentParameters +
+                    environment * dispatch.parameterCount,
+                internalState,
+                nextDeformation,
+                nextDeformationRate,
+                dt,
+                particle.referenceAndTemperature.w,
+                nextState
+            )) {
+            candidate[global] = particle;
+            recordFailure(
+                statuses[environment],
+                NM_STATUS_NONFINITE_RESULT,
+                objectIndex,
+                particleIndex,
+                float4(float(state), validityMargin, determinantValue, 0.0f)
+            );
+            return;
+        }
+        candidateMaterialState[materialStateBase + state] = nextState;
+    }
+    candidate[global] = next;
+}
+
+kernel void nm_mpm_commit_microstep(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const NMMatterStatusGPU* statuses [[buffer(1)]],
+    device NMParticleStateGPU* accepted [[buffer(2)]],
+    device NMParticleStateGPU* candidate [[buffer(3)]],
+    device float* acceptedMaterialState [[buffer(4)]],
+    device float* candidateMaterialState [[buffer(5)]],
+    uint global [[thread_position_in_grid]]
+) {
+    const uint total = dispatch.environmentCount * dispatch.particleCount;
+    if (global >= total || dispatch.particleCount == 0u) {
+        return;
+    }
+    const uint environment = global / dispatch.particleCount;
+    const uint stateBase = global * dispatch.materialStateStride;
+    if (environmentHealthy(statuses, environment)) {
+        accepted[global] = candidate[global];
+        for (uint state = 0u; state < dispatch.materialStateStride; ++state) {
+            acceptedMaterialState[stateBase + state] =
+                candidateMaterialState[stateBase + state];
+        }
+    } else {
+        candidate[global] = accepted[global];
+        for (uint state = 0u; state < dispatch.materialStateStride; ++state) {
+            candidateMaterialState[stateBase + state] =
+                acceptedMaterialState[stateBase + state];
+        }
+    }
+}
+
+kernel void nm_mpm_rollback_frame(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    device const NMMatterStatusGPU* statuses [[buffer(1)]],
+    device NMParticleStateGPU* accepted [[buffer(2)]],
+    device const NMParticleStateGPU* checkpoint [[buffer(3)]],
+    device float* acceptedMaterialState [[buffer(4)]],
+    device const float* checkpointMaterialState [[buffer(5)]],
+    uint global [[thread_position_in_grid]]
+) {
+    const uint total = dispatch.environmentCount * dispatch.particleCount;
+    if (global >= total || dispatch.particleCount == 0u) {
+        return;
+    }
+    const uint environment = global / dispatch.particleCount;
+    if (!environmentHealthy(statuses, environment)) {
+        accepted[global] = checkpoint[global];
+        const uint stateBase = global * dispatch.materialStateStride;
+        for (uint state = 0u; state < dispatch.materialStateStride; ++state) {
+            acceptedMaterialState[stateBase + state] =
+                checkpointMaterialState[stateBase + state];
+        }
+    }
+}
+
+} // namespace numi_matter_metal
diff --git a/matter/src/metal_world.cpp b/matter/src/metal_world.cpp
new file mode 100644
index 0000000000..c1dd786a96
--- /dev/null
+++ b/matter/src/metal_world.cpp
@@ -0,0 +1,118 @@
+#include "numi/matter/metal_world.hpp"
+
+#include <cmath>
+
+namespace numi::matter {
+namespace {
+
+std::uint64_t programFingerprint(
+    const std::uint64_t runtimeFingerprint,
+    const std::uint32_t flags
+) noexcept {
+    std::uint64_t fingerprint = runtimeFingerprint;
+    for (std::uint32_t shift = 0u; shift < 32u; shift += 8u) {
+        fingerprint ^= static_cast<std::uint8_t>(flags >> shift);
+        fingerprint *= 1099511628211ull;
+    }
+    return fingerprint == 0u ? 1u : fingerprint;
+}
+
+bool encodeMetalWorldMatter(
+    void* context,
+    const metalrobo::MetalWorldDevicePhysicsPass& pass
+) {
+    if (context == nullptr || pass.commandBuffer == nullptr ||
+        pass.physicsSubsteps == 0u ||
+        pass.physicsSubstep >= pass.physicsSubsteps) {
+        return false;
+    }
+    auto& runtime = *static_cast<Runtime*>(context);
+    EncodeRequest request{};
+    request.commandBuffer = pass.commandBuffer;
+    request.rigid.currentBodies = pass.currentBodies;
+    request.rigid.bodyWrenches = pass.bodyWrenches;
+    request.rigid.sceneBodies = pass.sceneBodies;
+    request.rigid.currentBodyCount = pass.bodyCount;
+    request.rigid.currentBodyStride = pass.bodyStateStride;
+    request.rigid.bodyWrenchCount = pass.bodyCount;
+    request.rigid.sceneBodyCount = pass.sceneBodyCount;
+    request.rigid.bodyWrenchStride = pass.bodyWrenchStride;
+    request.rigid.sceneStride = pass.sceneBodyStride;
+    request.environmentStatuses = pass.environmentStatuses;
+    request.rigidContactConstraints = pass.contactConstraints;
+    request.rigidContactStatuses = pass.contactStatuses;
+    request.rigidContactConstraintStride = pass.contactConstraintStride;
+    request.phase = pass.phase ==
+            metalrobo::MetalWorldDevicePhysicsPhase::postCommit
+        ? EncodePhase::postCommit
+        : EncodePhase::preDynamics;
+    const bool firstPrePass =
+        request.phase == EncodePhase::preDynamics &&
+        pass.physicsSubstep == 0u;
+    request.resetMasks = firstPrePass ? pass.resetMasks : nullptr;
+    request.resetMaskStepStride = firstPrePass
+        ? pass.resetMaskStepStride
+        : 0u;
+    const float cookedTimestep = runtime.timestepSeconds();
+    if (!std::isfinite(pass.timestepSeconds) ||
+        !(pass.timestepSeconds > 0.0f) ||
+        pass.timestepSeconds != cookedTimestep) {
+        return false;
+    }
+    request.controlStep = pass.controlStep;
+    request.physicsSubstep = pass.physicsSubstep;
+    request.physicsSubsteps = pass.physicsSubsteps;
+    request.seed = pass.seed;
+    request.timestepSeconds = pass.timestepSeconds;
+    // A MetalWorld submission encodes its full rollout horizon into one
+    // command buffer. Identification therefore updates/samples once at the
+    // beginning of that horizon; later control steps consume the same
+    // candidate material overlay and cannot race a CPU-authored loss buffer.
+    request.runIdentification =
+        runtime.automaticIdentificationEnabled() &&
+        request.phase == EncodePhase::preDynamics &&
+        pass.controlStep == 0u &&
+        pass.physicsSubstep == 0u;
+    request.runAdaptiveTransfer =
+        runtime.adaptiveTransferEnabled() &&
+        request.phase == EncodePhase::postCommit &&
+        pass.physicsSubstep + 1u == pass.physicsSubsteps;
+    return runtime.encode(request).encoded;
+}
+
+void abortMetalWorldMatter(
+    void* context,
+    void* commandBuffer
+) {
+    if (context != nullptr && commandBuffer != nullptr) {
+        static_cast<Runtime*>(context)->cancel(commandBuffer);
+    }
+}
+
+} // namespace
+
+metalrobo::MetalWorldDevicePhysicsProgram
+makeMetalWorldDevicePhysicsProgram(Runtime& runtime) noexcept {
+    metalrobo::MetalWorldDevicePhysicsProgram program{};
+    if (!runtime.valid() || runtime.deviceProgramFingerprint() == 0u) {
+        return program;
+    }
+    program.context = &runtime;
+    program.encode = &encodeMetalWorldMatter;
+    program.abort = &abortMetalWorldMatter;
+    program.flags =
+        (runtime.requiresBodyWrenches()
+             ? metalrobo::MetalWorldDevicePhysicsWritesBodyWrenches
+             : 0u) |
+        (runtime.requiresRigidContactEvidence()
+             ? metalrobo::
+                   MetalWorldDevicePhysicsRequiresRigidContactEvidence
+             : 0u);
+    program.fingerprint = programFingerprint(
+        runtime.deviceProgramFingerprint(),
+        program.flags
+    );
+    return program;
+}
+
+} // namespace numi::matter
diff --git a/matter/src/package_impl.cpp b/matter/src/package_impl.cpp
new file mode 100644
index 0000000000..2c211e5cec
--- /dev/null
+++ b/matter/src/package_impl.cpp
@@ -0,0 +1,487 @@
+#include "numi/matter/detail.hpp"
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <limits>
+#include <set>
+#include <string>
+#include <type_traits>
+#include <utility>
+#include <vector>
+
+namespace numi::matter {
+namespace {
+
+inline constexpr std::array<char, 16> kMagic{
+    'N', 'U', 'M', 'I', 'M', 'A', 'T', 'T',
+    'E', 'R', 'P', 'K', 'G', '\0', '\0', '\0',
+};
+inline constexpr std::uint32_t kPackageVersion = 3u;
+inline constexpr std::uint32_t kEndianMarker = 0x01020304u;
+
+enum class Section : std::uint32_t {
+    dispatch = 1u,
+    materials,
+    parameters,
+    stateInitials,
+    instructions,
+    scalarPrograms,
+    objects,
+    mpmParticles,
+    mpmNodes,
+    mpmGrids,
+    mpmBlocks,
+    mpmBlockLookup,
+    mpmStencils,
+    mpmNodeIncidence,
+    mpmNodeRanges,
+    femNodes,
+    femTetrahedra,
+    femNodeIncidence,
+    femNodeRanges,
+    rigidProxies,
+    contactPairs,
+    contactNodeIncidence,
+    contactNodeRanges,
+    rigidIncidence,
+    rigidRanges,
+    adaptive,
+    schedulers,
+    identification,
+    generatedMetal,
+};
+
+inline constexpr std::uint32_t kSectionCount =
+    static_cast<std::uint32_t>(Section::generatedMetal);
+
+struct PackageHeader {
+    std::array<char, 16> magic{};
+    std::uint32_t version = 0u;
+    std::uint32_t endian = 0u;
+    std::uint32_t matterAbiVersion = 0u;
+    std::uint32_t sectionCount = 0u;
+    std::uint64_t fingerprint = 0u;
+    std::uint64_t headerHash = 0u;
+};
+
+struct SectionHeader {
+    std::uint32_t id = 0u;
+    std::uint32_t elementSize = 0u;
+    std::uint64_t elementCount = 0u;
+    std::uint64_t byteCount = 0u;
+    std::uint64_t contentHash = 0u;
+};
+
+static_assert(std::is_trivially_copyable_v<PackageHeader>);
+static_assert(std::is_trivially_copyable_v<SectionHeader>);
+
+template <typename T>
+[[nodiscard]] bool writeRaw(std::ofstream& stream, const T& value) {
+    static_assert(std::is_trivially_copyable_v<T>);
+    stream.write(reinterpret_cast<const char*>(&value), sizeof(T));
+    return static_cast<bool>(stream);
+}
+
+[[nodiscard]] bool writeBytes(
+    std::ofstream& stream,
+    const void* data,
+    const std::size_t bytes
+) {
+    if (bytes == 0u) {
+        return true;
+    }
+    stream.write(static_cast<const char*>(data), static_cast<std::streamsize>(bytes));
+    return static_cast<bool>(stream);
+}
+
+template <typename T>
+[[nodiscard]] bool writeSection(
+    std::ofstream& stream,
+    const Section id,
+    const std::span<const T> values
+) {
+    static_assert(std::is_trivially_copyable_v<T>);
+    if (values.size() > std::numeric_limits<std::uint64_t>::max() / sizeof(T)) {
+        return false;
+    }
+    SectionHeader header{};
+    header.id = static_cast<std::uint32_t>(id);
+    header.elementSize = sizeof(T);
+    header.elementCount = values.size();
+    header.byteCount = values.size_bytes();
+    header.contentHash = detail::hashBytes(values.data(), values.size_bytes());
+    return writeRaw(stream, header) &&
+        writeBytes(stream, values.data(), values.size_bytes());
+}
+
+[[nodiscard]] bool writeStringSection(
+    std::ofstream& stream,
+    const Section id,
+    const std::string_view value
+) {
+    SectionHeader header{};
+    header.id = static_cast<std::uint32_t>(id);
+    header.elementSize = 1u;
+    header.elementCount = value.size();
+    header.byteCount = value.size();
+    header.contentHash = detail::hashString(value);
+    return writeRaw(stream, header) && writeBytes(stream, value.data(), value.size());
+}
+
+template <typename T>
+[[nodiscard]] bool readRaw(std::ifstream& stream, T& value) {
+    static_assert(std::is_trivially_copyable_v<T>);
+    stream.read(reinterpret_cast<char*>(&value), sizeof(T));
+    return static_cast<bool>(stream);
+}
+
+[[nodiscard]] bool readBytes(
+    std::ifstream& stream,
+    void* data,
+    const std::size_t bytes
+) {
+    if (bytes == 0u) {
+        return true;
+    }
+    stream.read(static_cast<char*>(data), static_cast<std::streamsize>(bytes));
+    return static_cast<bool>(stream);
+}
+
+template <typename T>
+[[nodiscard]] bool decodeVector(
+    std::ifstream& stream,
+    const SectionHeader& header,
+    std::vector<T>& output,
+    std::string* error
+) {
+    static_assert(std::is_trivially_copyable_v<T>);
+    if (header.elementSize != sizeof(T) ||
+        header.elementCount > std::numeric_limits<std::size_t>::max() ||
+        header.byteCount != header.elementCount * sizeof(T) ||
+        header.byteCount > std::numeric_limits<std::size_t>::max()) {
+        if (error != nullptr) {
+            *error = "matter package section has an incompatible element layout";
+        }
+        return false;
+    }
+    std::vector<T> candidate(static_cast<std::size_t>(header.elementCount));
+    if (!readBytes(stream, candidate.data(), candidate.size() * sizeof(T))) {
+        if (error != nullptr) {
+            *error = "matter package ended inside a typed section";
+        }
+        return false;
+    }
+    if (detail::hashBytes(candidate.data(), candidate.size() * sizeof(T)) !=
+        header.contentHash) {
+        if (error != nullptr) {
+            *error = "matter package section content hash mismatch";
+        }
+        return false;
+    }
+    output = std::move(candidate);
+    return true;
+}
+
+[[nodiscard]] bool skipSection(
+    std::ifstream& stream,
+    const SectionHeader& header,
+    std::string* error
+) {
+    if (header.byteCount > static_cast<std::uint64_t>(
+            std::numeric_limits<std::streamoff>::max())) {
+        if (error != nullptr) {
+            *error = "matter package section is too large to seek";
+        }
+        return false;
+    }
+    stream.seekg(static_cast<std::streamoff>(header.byteCount), std::ios::cur);
+    if (!stream) {
+        if (error != nullptr) {
+            *error = "matter package ended while skipping an unknown section";
+        }
+        return false;
+    }
+    return true;
+}
+
+[[nodiscard]] std::uint64_t headerHash(PackageHeader header) {
+    header.headerHash = 0u;
+    return detail::hashBytes(&header, sizeof(header));
+}
+
+} // namespace
+
+bool writePackage(
+    const CompileResult& compiled,
+    const std::filesystem::path& path,
+    std::string* error
+) {
+    if (!compiled.succeeded()) {
+        if (error != nullptr) {
+            *error = "cannot write a matter package from a failed compile";
+        }
+        return false;
+    }
+    const CompiledWorld& world = compiled.world;
+    std::string layoutError;
+    if (!validateCompiledWorldLayout(world, &layoutError)) {
+        if (error != nullptr) {
+            *error = "cannot package an invalid Matter world: " + layoutError;
+        }
+        return false;
+    }
+    std::ofstream stream(path, std::ios::binary | std::ios::trunc);
+    if (!stream) {
+        if (error != nullptr) {
+            *error = "cannot create matter package: " + path.string();
+        }
+        return false;
+    }
+
+    PackageHeader header{};
+    header.magic = kMagic;
+    header.version = kPackageVersion;
+    header.endian = kEndianMarker;
+    header.matterAbiVersion = NM_MATTER_ABI_VERSION;
+    header.sectionCount = kSectionCount;
+    header.fingerprint = world.fingerprint;
+    header.headerHash = headerHash(header);
+    if (!writeRaw(stream, header)) {
+        if (error != nullptr) {
+            *error = "failed to write matter package header";
+        }
+        return false;
+    }
+
+    const bool written =
+        writeSection(stream, Section::dispatch,
+            std::span<const NMMatterDispatchGPU>(&world.dispatch, 1u)) &&
+        writeSection(stream, Section::materials,
+            std::span<const NMMaterialGPU>(world.materials)) &&
+        writeSection(stream, Section::parameters,
+            std::span<const NMParameterRangeGPU>(world.parameters)) &&
+        writeSection(stream, Section::stateInitials,
+            std::span<const float>(world.stateInitials)) &&
+        writeSection(stream, Section::instructions,
+            std::span<const NMExpressionInstructionGPU>(world.instructions)) &&
+        writeSection(stream, Section::scalarPrograms,
+            std::span<const NMScalarProgramGPU>(world.scalarPrograms)) &&
+        writeSection(stream, Section::objects,
+            std::span<const NMContinuumObjectGPU>(world.objects)) &&
+        writeSection(stream, Section::mpmParticles,
+            std::span<const NMParticleStateGPU>(world.mpm.particles)) &&
+        writeSection(stream, Section::mpmNodes,
+            std::span<const NMGridNodeStateGPU>(world.mpm.nodes)) &&
+        writeSection(stream, Section::mpmGrids,
+            std::span<const NMMPMGridGPU>(world.mpm.grids)) &&
+        writeSection(stream, Section::mpmBlocks,
+            std::span<const NMMPMBlockGPU>(world.mpm.blocks)) &&
+        writeSection(stream, Section::mpmBlockLookup,
+            std::span<const std::uint32_t>(world.mpm.blockLookup)) &&
+        writeSection(stream, Section::mpmStencils,
+            std::span<const NMMPMStencilGPU>(world.mpm.stencils)) &&
+        writeSection(stream, Section::mpmNodeIncidence,
+            std::span<const std::uint32_t>(world.mpm.nodeIncidence)) &&
+        writeSection(stream, Section::mpmNodeRanges,
+            std::span<const NMIncidenceRangeGPU>(world.mpm.nodeRanges)) &&
+        writeSection(stream, Section::femNodes,
+            std::span<const NMFEMNodeStateGPU>(world.fem.nodes)) &&
+        writeSection(stream, Section::femTetrahedra,
+            std::span<const NMTetrahedronGPU>(world.fem.tetrahedra)) &&
+        writeSection(stream, Section::femNodeIncidence,
+            std::span<const std::uint32_t>(world.fem.nodeIncidence)) &&
+        writeSection(stream, Section::femNodeRanges,
+            std::span<const NMIncidenceRangeGPU>(world.fem.nodeRanges)) &&
+        writeSection(stream, Section::rigidProxies,
+            std::span<const NMRigidProxyGPU>(world.contact.rigidProxies)) &&
+        writeSection(stream, Section::contactPairs,
+            std::span<const NMContactPairGPU>(world.contact.pairs)) &&
+        writeSection(stream, Section::contactNodeIncidence,
+            std::span<const std::uint32_t>(world.contact.nodeIncidence)) &&
+        writeSection(stream, Section::contactNodeRanges,
+            std::span<const NMIncidenceRangeGPU>(world.contact.nodeRanges)) &&
+        writeSection(stream, Section::rigidIncidence,
+            std::span<const std::uint32_t>(world.contact.rigidIncidence)) &&
+        writeSection(stream, Section::rigidRanges,
+            std::span<const NMIncidenceRangeGPU>(world.contact.rigidRanges)) &&
+        writeSection(stream, Section::adaptive,
+            std::span<const NMAdaptiveStateGPU>(world.adaptive)) &&
+        writeSection(stream, Section::schedulers,
+            std::span<const NMSchedulerStateGPU>(world.schedulers)) &&
+        writeSection(stream, Section::identification,
+            std::span<const NMIdentificationDistributionGPU>(world.identification)) &&
+        writeStringSection(stream, Section::generatedMetal, compiled.generatedMetal);
+
+    if (!written || !stream.flush()) {
+        if (error != nullptr) {
+            *error = "failed while writing matter package sections";
+        }
+        return false;
+    }
+    return true;
+}
+
+bool readPackage(
+    const std::filesystem::path& path,
+    CompiledWorld& world,
+    std::string* generatedMetal,
+    std::string* error
+) {
+    std::ifstream stream(path, std::ios::binary);
+    if (!stream) {
+        if (error != nullptr) {
+            *error = "cannot open matter package: " + path.string();
+        }
+        return false;
+    }
+    PackageHeader header{};
+    if (!readRaw(stream, header) || header.magic != kMagic ||
+        header.version != kPackageVersion ||
+        header.endian != kEndianMarker ||
+        header.matterAbiVersion != NM_MATTER_ABI_VERSION ||
+        header.headerHash != headerHash(header) ||
+        header.sectionCount != kSectionCount) {
+        if (error != nullptr) {
+            *error = "invalid or unsupported matter package header";
+        }
+        return false;
+    }
+
+    CompiledWorld candidate;
+    std::string generatedCandidate;
+    std::set<std::uint32_t> seen;
+    for (std::uint32_t sectionIndex = 0u;
+         sectionIndex < header.sectionCount;
+         ++sectionIndex) {
+        SectionHeader section{};
+        if (!readRaw(stream, section) || !seen.insert(section.id).second) {
+            if (error != nullptr) {
+                *error = "matter package contains a missing or duplicate section header";
+            }
+            return false;
+        }
+        const Section id = static_cast<Section>(section.id);
+        bool decoded = false;
+        switch (id) {
+        case Section::dispatch: {
+            std::vector<NMMatterDispatchGPU> values;
+            decoded = decodeVector(stream, section, values, error) && values.size() == 1u;
+            if (decoded) candidate.dispatch = values.front();
+            break;
+        }
+        case Section::materials:
+            decoded = decodeVector(stream, section, candidate.materials, error); break;
+        case Section::parameters:
+            decoded = decodeVector(stream, section, candidate.parameters, error); break;
+        case Section::stateInitials:
+            decoded = decodeVector(stream, section, candidate.stateInitials, error); break;
+        case Section::instructions:
+            decoded = decodeVector(stream, section, candidate.instructions, error); break;
+        case Section::scalarPrograms:
+            decoded = decodeVector(stream, section, candidate.scalarPrograms, error); break;
+        case Section::objects:
+            decoded = decodeVector(stream, section, candidate.objects, error); break;
+        case Section::mpmParticles:
+            decoded = decodeVector(stream, section, candidate.mpm.particles, error); break;
+        case Section::mpmNodes:
+            decoded = decodeVector(stream, section, candidate.mpm.nodes, error); break;
+        case Section::mpmGrids:
+            decoded = decodeVector(stream, section, candidate.mpm.grids, error); break;
+        case Section::mpmBlocks:
+            decoded = decodeVector(stream, section, candidate.mpm.blocks, error); break;
+        case Section::mpmBlockLookup:
+            decoded = decodeVector(stream, section, candidate.mpm.blockLookup, error); break;
+        case Section::mpmStencils:
+            decoded = decodeVector(stream, section, candidate.mpm.stencils, error); break;
+        case Section::mpmNodeIncidence:
+            decoded = decodeVector(stream, section, candidate.mpm.nodeIncidence, error); break;
+        case Section::mpmNodeRanges:
+            decoded = decodeVector(stream, section, candidate.mpm.nodeRanges, error); break;
+        case Section::femNodes:
+            decoded = decodeVector(stream, section, candidate.fem.nodes, error); break;
+        case Section::femTetrahedra:
+            decoded = decodeVector(stream, section, candidate.fem.tetrahedra, error); break;
+        case Section::femNodeIncidence:
+            decoded = decodeVector(stream, section, candidate.fem.nodeIncidence, error); break;
+        case Section::femNodeRanges:
+            decoded = decodeVector(stream, section, candidate.fem.nodeRanges, error); break;
+        case Section::rigidProxies:
+            decoded = decodeVector(stream, section, candidate.contact.rigidProxies, error); break;
+        case Section::contactPairs:
+            decoded = decodeVector(stream, section, candidate.contact.pairs, error); break;
+        case Section::contactNodeIncidence:
+            decoded = decodeVector(stream, section, candidate.contact.nodeIncidence, error); break;
+        case Section::contactNodeRanges:
+            decoded = decodeVector(stream, section, candidate.contact.nodeRanges, error); break;
+        case Section::rigidIncidence:
+            decoded = decodeVector(stream, section, candidate.contact.rigidIncidence, error); break;
+        case Section::rigidRanges:
+            decoded = decodeVector(stream, section, candidate.contact.rigidRanges, error); break;
+        case Section::adaptive:
+            decoded = decodeVector(stream, section, candidate.adaptive, error); break;
+        case Section::schedulers:
+            decoded = decodeVector(stream, section, candidate.schedulers, error); break;
+        case Section::identification:
+            decoded = decodeVector(stream, section, candidate.identification, error); break;
+        case Section::generatedMetal: {
+            if (section.elementSize != 1u ||
+                section.elementCount != section.byteCount ||
+                section.byteCount > std::numeric_limits<std::size_t>::max()) {
+                if (error != nullptr) {
+                    *error = "generated Metal section has an invalid layout";
+                }
+                return false;
+            }
+            generatedCandidate.resize(static_cast<std::size_t>(section.byteCount));
+            decoded = readBytes(stream, generatedCandidate.data(), generatedCandidate.size()) &&
+                detail::hashString(generatedCandidate) == section.contentHash;
+            if (!decoded && error != nullptr) {
+                *error = "generated Metal section is truncated or corrupted";
+            }
+            break;
+        }
+        default:
+            decoded = skipSection(stream, section, error);
+            break;
+        }
+        if (!decoded) {
+            if (error != nullptr && error->empty()) {
+                *error = "failed to decode matter package section " +
+                    std::to_string(section.id);
+            }
+            return false;
+        }
+    }
+
+    for (std::uint32_t id = 1u; id <= kSectionCount; ++id) {
+        if (!seen.contains(id)) {
+            if (error != nullptr) {
+                *error = "matter package is missing required section " +
+                    std::to_string(id);
+            }
+            return false;
+        }
+    }
+
+    candidate.fingerprint = header.fingerprint;
+    std::string layoutError;
+    if (!validateCompiledWorldLayout(candidate, &layoutError)) {
+        if (error != nullptr) {
+            *error = "matter package contains an invalid execution layout: " +
+                layoutError;
+        }
+        return false;
+    }
+    world = std::move(candidate);
+    if (generatedMetal != nullptr) {
+        *generatedMetal = std::move(generatedCandidate);
+    }
+    return true;
+}
