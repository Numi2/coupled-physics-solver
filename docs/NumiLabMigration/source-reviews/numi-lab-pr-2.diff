+} NMIdentificationDistributionGPU;
+
+typedef struct NM_ALIGN16 NMIdentificationCandidateGPU {
+    nm_u32 environment;
+    nm_u32 candidate;
+    nm_u32 distribution;
+    nm_u32 antitheticPartner;
+    // value, normalized perturbation, loss, weight.
+    nm_float4 sample;
+} NMIdentificationCandidateGPU;
+
+typedef struct NM_ALIGN16 NMSchedulerStateGPU {
+    nm_u32 baseExponent;
+    nm_u32 activeExponent;
+    nm_u32 requestedExponent;
+    nm_u32 quietFrames;
+
+    // contact speed, slip impulse, maximum strain, maximum stress.
+    nm_float4 physical;
+    // minimum J, solver residual, damage, continuum-enabled flag.
+    nm_float4 numerical;
+    // contact, slip, strain, residual thresholds.
+    nm_float4 thresholds;
+    // elapsed episode time, last event time, last event delta, event count.
+    nm_float4 timing;
+} NMSchedulerStateGPU;
+
+typedef struct NM_ALIGN16 NMEventTokenGPU {
+    nm_u32 environment;
+    nm_u32 objectIndex;
+    nm_u32 eventClass;
+    nm_u32 flags;
+    // episode time, delta since the previous object event, severity, current.
+    nm_float4 payload;
+    // previous value, current value, reserved, reserved.
+    nm_float4 transition;
+} NMEventTokenGPU;
+
+typedef struct NM_ALIGN16 NMMatterStatusGPU {
+    nm_u32 code;
+    nm_u32 environment;
+    nm_u32 objectIndex;
+    nm_u32 failingIndex;
+
+    nm_u32 completedMicrosteps;
+    nm_u32 pcgIterations;
+    nm_u32 contactCount;
+    nm_u32 eventCount;
+
+    // minimum J, maximum stress, residual, correction.
+    nm_float4 diagnostics;
+} NMMatterStatusGPU;
+
+#ifndef __METAL_VERSION__
+static_assert(sizeof(nm_float4) == 16);
+static_assert(sizeof(nm_uint4) == 16);
+static_assert(sizeof(nm_int4) == 16);
+static_assert(sizeof(NMMatterDispatchGPU) % 16 == 0);
+static_assert(sizeof(NMMicrostepGPU) % 16 == 0);
+static_assert(sizeof(NMResetPassGPU) == 16);
+static_assert(sizeof(NMBridgeDispatchGPU) % 16 == 0);
+static_assert(sizeof(NMRigidProxyGPU) == 80);
+static_assert(sizeof(NMMaterialGPU) % 16 == 0);
+static_assert(sizeof(NMContinuumObjectGPU) % 16 == 0);
+static_assert(sizeof(NMMPMGridGPU) == 80);
+static_assert(sizeof(NMMPMBlockGPU) == 32);
+static_assert(sizeof(NMParticleStateGPU) % 16 == 0);
+static_assert(sizeof(NMFEMNodeStateGPU) % 16 == 0);
+static_assert(sizeof(NMAdaptiveStateGPU) == 160);
+static_assert(sizeof(NMSchedulerStateGPU) == 80);
+static_assert(sizeof(NMEventTokenGPU) == 48);
+#endif
diff --git a/matter/materials/damageable_silicone.nmatter b/matter/materials/damageable_silicone.nmatter
new file mode 100644
index 0000000000..dc393b66bd
--- /dev/null
+++ b/matter/materials/damageable_silicone.nmatter
@@ -0,0 +1,68 @@
+material damageable_silicone {
+    parameter density : kg/m^3 = 1100 in [900, 1300];
+    parameter mu : kPa = 150 in [5, 1000] log identifiable;
+    parameter lambda : MPa = 3 in [0.1, 30] log identifiable;
+    parameter eta : Pa*s = 1500 in [10, 10000] log identifiable;
+    parameter damage_rate : one/s = 20 in [0, 200] identifiable;
+    parameter damage_threshold : one = 0.01 in [0, 0.5];
+    parameter maximum_damage : one = 0.95 in [0.5, 0.99];
+
+    state damage : one = 0;
+    state accumulated_strain : one = 0;
+
+    model visco_hyperelastic;
+
+    // Damage degrades both shear and volumetric stiffness while retaining a
+    // positive residual stiffness through maximum_damage < 1.
+    energy = neo_hookean(
+        mu * (1 - damage),
+        lambda * (1 - damage)
+    );
+
+    // Rate-dependent resistance is defined in material coordinates from
+    // Fdot. MPM reconstructs Fdot = L F from its APIC spatial gradient, while
+    // FEM evaluates Fdot directly from the rest-configuration velocity field.
+    dissipation = 0.5 * eta * (
+        pow(Fdot(0, 0), 2) +
+        pow(Fdot(1, 1), 2) +
+        pow(Fdot(2, 2), 2) +
+        0.5 * pow(Fdot(0, 1) + Fdot(1, 0), 2) +
+        0.5 * pow(Fdot(0, 2) + Fdot(2, 0), 2) +
+        0.5 * pow(Fdot(1, 2) + Fdot(2, 1), 2)
+    );
+
+    update accumulated_strain = accumulated_strain + dt() * sqrt(
+        pow(Fdot(0, 0), 2) +
+        pow(Fdot(1, 1), 2) +
+        pow(Fdot(2, 2), 2) +
+        0.5 * pow(Fdot(0, 1) + Fdot(1, 0), 2) +
+        0.5 * pow(Fdot(0, 2) + Fdot(2, 0), 2) +
+        0.5 * pow(Fdot(1, 2) + Fdot(2, 1), 2)
+    );
+
+    update damage = clamp(
+        damage + dt() * damage_rate * max(
+            sqrt(I1() / 3) - 1 - damage_threshold,
+            0
+        ),
+        0,
+        maximum_damage
+    );
+
+    valid = min(J() - 0.05, maximum_damage - damage + 0.001);
+    supports mpm, fem, rigid;
+
+    interface {
+        static_friction = 0.80;
+        dynamic_friction = 0.65;
+        restitution = 0.0;
+        adhesion = 0.0;
+    }
+
+    limits {
+        minimum_J = 0.05;
+        maximum_J = 20.0;
+        maximum_stress = 1e9;
+        maximum_energy_density = 1e9;
+    }
+}
